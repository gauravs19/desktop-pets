<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.gauravs</groupId>
  <artifactId>desktop-pets</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>Desktop Pets</name>
  <description>Animated pets that live on your Windows desktop, built from scratch on JavaFX.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.5</javafx.version>
    <!--
      Fallback JavaFX platform classifier, used only if none of the OS profiles below matches.
      Override explicitly with -Djavafx.platform=linux to cross-build for another platform.
    -->
    <javafx.platform>win</javafx.platform>
    <main.class>dev.gauravs.desktoppets.Launcher</main.class>
  </properties>

  <!--
    JavaFX artifacts are platform-specific, so the classifier is chosen from the building machine's
    OS and CPU. A consequence worth knowing: the shaded jar this produces runs on the platform it was
    built on, not everywhere. That is the price of bundling JavaFX so users need no separate install.
  -->
  <profiles>
    <profile>
      <id>platform-windows</id>
      <activation><os><family>windows</family></os></activation>
      <properties><javafx.platform>win</javafx.platform></properties>
    </profile>
    <profile>
      <id>platform-mac-intel</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties><javafx.platform>mac</javafx.platform></properties>
    </profile>
    <profile>
      <id>platform-mac-apple-silicon</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties><javafx.platform>mac-aarch64</javafx.platform></properties>
    </profile>
    <profile>
      <id>platform-linux-x86</id>
      <activation><os><name>linux</name><arch>amd64</arch></os></activation>
      <properties><javafx.platform>linux</javafx.platform></properties>
    </profile>
    <profile>
      <id>platform-linux-arm</id>
      <activation><os><name>linux</name><arch>aarch64</arch></os></activation>
      <properties><javafx.platform>linux-aarch64</javafx.platform></properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
  </dependencies>

  <build>
    <finalName>desktop-pets</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- Fat jar so `java -jar target/desktop-pets.jar` just works. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
