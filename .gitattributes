# Normalise text in the repo regardless of a contributor's core.autocrlf setting.
* text=auto

# Shell scripts must be LF even when checked out on Windows: a CRLF shebang fails on macOS and
# Linux with "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# PowerShell is happy either way, but CRLF is the native convention.
*.ps1 text eol=crlf

*.png binary
